#!/usr/bin/make -f

NULL =

DEB_HOST_ARCH=$(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_FDK_SUPPORT=$(shell dpkg-query -s libfdk-aac-dev 2>&1 >/dev/null; echo $$?)
DEB_SDL3_SUPPORT=$(shell dpkg-query -s libsdl3-dev libsdl3-image-dev libsdl3-ttf-dev 2>&1 >/dev/null; echo $$?)

ifeq ($(DEB_FDK_SUPPORT),0)
	AAC_SUPPORT = -DWITH_FDK_AAC=ON
endif
ifeq ($(DEB_SDL3_SUPPORT),0)
	SDL3_SUPPORT = -DWITH_CLIENT_SDL3=ON
else
	SDL3_SUPPORT = -DWITH_CLIENT_SDL3=OFF
endif
SANITIZE_ADDRESS = -DWITH_SANITIZE_ADDRESS=ON

DEB_CMAKE_EXTRA_FLAGS := \
						  -DCMAKE_BUILD_TYPE="Debug" \
						  -DCMAKE_INSTALL_PREFIX=/opt/freerdp-nightly/ \
						  -DCMAKE_C_FLAGS="-O1" \
						  -DCMAKE_CXX_FLAGS="-O1" \
						  -DCMAKE_INSTALL_INCLUDEDIR=include \
						  -DCMAKE_INSTALL_LIBDIR=lib \
						  -DCMAKE_CTEST_ARGUMENTS="-DExperimentalTest;--output-on-failure;--no-compress-output" \
						  $(AAC_SUPPORT) \
						  $(SDL3_SUPPORT) \
						  $(SANITIZE_ADDRESS) \
						  $(NULL)

DEB_DISTRO_ID := $(shell . /etc/os-release 2>/dev/null; printf '%s' "$$ID")
DEB_DISTRO_VERSION_ID := $(shell . /etc/os-release 2>/dev/null; printf '%s' "$$VERSION_ID")
ifeq ($(DEB_DISTRO_ID):$(DEB_DISTRO_VERSION_ID),ubuntu:20.04)
# Ubuntu 20.04 ships libaom 1.0.0, too old for the nightly AV1 package path.
DEB_CMAKE_EXTRA_FLAGS += \
						  -DWITH_GFX_AV1=OFF \
						  -DWITH_AOM=OFF \
						  -DWITH_SVTAV1=OFF \
						  -DWITH_DAV1D=OFF \
						  $(NULL)
endif

%:
	dh $@ --parallel --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake+ninja -- -DCMAKE_MODULE_PATH=$(PWD)/cmake -DCMAKE_PROJECT_FreeRDP_INCLUDE=$(PWD)/packaging/deb/freerdp-nightly/cmake-preload.cmake $(DEB_CMAKE_EXTRA_FLAGS)

override_dh_shlibdeps:
	dh_shlibdeps -l /opt/freerdp-nightly/lib/

override_dh_strip:
	dh_strip --dbg-package=freerdp-nightly-dbg

override_dh_missing:
	dh_missing --fail-missing
